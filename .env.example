# =========================================
# إعدادات بوت شبكة العنكبوت Al_Ankaboot
# =========================================

# 1. توكن البوت من @BotFather
# جيبه من BotFather بأمر /newbot
TELEGRAM_BOT_TOKEN=ضع_التوكن_هنا

# 2. منفذ API للميكروتيك 
# الافتراضي 8728. لا تغيره الا لو غيرته في الميكروتيك
MIKROTIK_API_PORT=8728

# 3. اليوزرات المسموح لها تستخدم البوت
# حط رقمك في التليجرام. للاضافة افصل بفاصلة 1511968,123456789
ALLOWED_USERS=1511968

# =========================================
# اختياري - لو حبيت تستخدمه لاحقاً
# =========================================

# اسم قاعدة البيانات لحفظ بيانات تسجيل الدخول لكل مستخدم
# DB_FILE=logins.db
