# bot.py (النسخة المطورة)
import os, logging
from dotenv import load_dotenv
from telegram import Update, ReplyKeyboardMarkup, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import ApplicationBuilder, CommandHandler, MessageHandler, filters, ContextTypes, CallbackQueryHandler
from routeros_api import RouterOsApiPool

load_dotenv()
TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
ALLOWED_USERS = [int(x) for x in os.getenv("ALLOWED_USERS", "").split(",") if x]
logging.basicConfig(level=logging.INFO)

# تخزين جلسات المستخدمين (مؤقت)
sessions = {}

def connect(ip, user, pw):
    try:
        pool = RouterOsApiPool(ip, username=user, password=pw, plaintext_login=True, port=8728)
        api = pool.get_api()
        return api, pool
    except Exception as e:
        return None, str(e)

# لوحة المفاتيح الرئيسية
main_keyboard = ReplyKeyboardMarkup([
    ['📡 عرض الهوبات', '👥 مستخدمين هوب'],
    ['⚡ فصل مستخدم', '⏹️ إيقاف هوب'],
    ['▶️ تشغيل هوب', '📊 حركة الهوب'],
    ['🔐 تسجيل الدخول', 'ℹ️ الحالة']
], resize_keyboard=True)

async def start(update: Update, context):
    uid = update.effective_user.id
    if uid not in ALLOWED_USERS:
        await update.message.reply_text("❌ غير مصرح")
        return
    sessions[uid] = {}  # تهيئة الجلسة
    await update.message.reply_text(
        "🕸️ مرحبا في بوت شبكة العنكبوت\n"
        "اضغط 'تسجيل الدخول' لإدخال بيانات الميكروتيك، أو استخدم الأزرار.",
        reply_markup=main_keyboard
    )

async def login(update: Update, context):
    uid = update.effective_user.id
    await update.message.reply_text("أرسل بيانات الدخول: `IP username password`", parse_mode='Markdown')

async def handle_text(update: Update, context):
    uid = update.effective_user.id
    text = update.message.text

    # 1. معالجة تسجيل الدخول
    if len(text.split()) == 3 and text.count(' ') == 2:
        ip, user, pw = text.split()
        api, err = connect(ip, user, pw)
        if api:
            sessions[uid] = {'ip': ip, 'user': user, 'pw': pw, 'api': api, 'pool': None} # حذفنا الpool للتبسيط
            await update.message.reply_text("✅ تم الاتصال!", reply_markup=main_keyboard)
        else:
            await update.message.reply_text(f"❌ فشل: {err}")
        return

    # 2. معالجة الأزرار (الأوامر)
    if uid not in sessions or 'ip' not in sessions[uid]:
        await update.message.reply_text("⚠️ سجل الدخول أولاً باستخدام 'تسجيل الدخول'")
        return

    api, err = connect(sessions[uid]['ip'], sessions[uid]['user'], sessions[uid]['pw'])
    if not api:
        await update.message.reply_text(f"❌ فقد الاتصال: {err}")
        return

    if text == '📡 عرض الهوبات':
        # مثال: جلب الـ Interfaces
        result = api.get_resource('/interface').get()
        msg = "📡 الهوبات:\n" + "\n".join([f"{r.get('name')} -> {r.get('running')}" for r in result[:10]])
        await update.message.reply_text(msg)
    
    elif text == '👥 مستخدمين هوب':
        # مثال: جلب مستخدمي الـ Hotspot
        result = api.get_resource('/ip/hotspot/host').get()
        msg = "👥 المستخدمون:\n" + "\n".join([f"{r.get('user')} - {r.get('address')}" for r in result[:10]])
        await update.message.reply_text(msg)
    
    # ... باقي الأوامر (فصل، إيقاف، تشغيل) تضيفها بنفس المنطق

    api.get_resource('/').call('quit') # إغلاق الاتصال بعد كل أمر

async def handle_callback(update: Update, context):
    # للتعامل مع الأزرار المضمنة (اختياري)
    query = update.callback_query
    await query.answer()
    # منطقك هنا

def main():
    app = ApplicationBuilder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text))
    app.add_handler(CallbackQueryHandler(handle_callback))
    print("✅ البوت شغال...")
    app.run_polling()

if __name__ == '__main__':
    main()
