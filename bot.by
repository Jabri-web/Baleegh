# bot.py

import os
import logging
from dotenv import load_dotenv
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, MessageHandler, filters, ContextTypes
from routeros_api import RouterOsApiPool

load_dotenv()

TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
ALLOWED_USERS = [int(x) for x in os.getenv("ALLOWED_USERS", "").split(",") if x]

logging.basicConfig(format='%(asctime)s - %(name)s - %(levelname)s - %(message)s', level=logging.INFO)
user_data = {}

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id not in ALLOWED_USERS:
        await update.message.reply_text("❌ غير مصرح لك باستخدام البوت")
        return
    await update.message.reply_text(
        "🕸️ مرحبا بك في بوت شبكة العنكبوت\n"
        "ارسل بيانات الميكروتيك بهذا الشكل:\n"
        "`IP username password`",
        parse_mode='Markdown'
    )

def connect_mikrotik(ip, username, password):
    try:
        pool = RouterOsApiPool(ip, username=username, password=password, plaintext_login=True, port=8728)
        api = pool.get_api()
        return api, pool
    except Exception as e:
        return None, str(e)

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id not in ALLOWED_USERS:
        return
    
    text = update.message.text
    parts = text.split()
    
    if len(parts) == 3:
        ip, user, pw = parts
        user_data[update.effective_user.id] = {'ip': ip, 'user': user, 'pw': pw}
        api, pool = connect_mikrotik(ip, user, pw)
        if api:
            await update.message.reply_text("✅ تم الاتصال بالميكروتيك بنجاح")
            pool.disconnect()
        else:
            await update.message.reply_text(f"❌ فشل الاتصال: {pool}")
    else:
        await update.message.reply_text("الصيغة خطأ. ارسل: `IP username password`", parse_mode='Markdown')

def main():
    app = ApplicationBuilder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))

    print("✅ البوت شغال Polling - بدون سيرفر")
    app.run_polling() # <-- ده التغيير. بدل webhook

if __name__ == '__main__':
    main()
